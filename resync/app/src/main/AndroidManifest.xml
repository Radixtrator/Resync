<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Metered-network checks: Data saving "On mobile data" and HD video "WiFi only". -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Watched communities and the inbox check notify. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Saving media to Pictures/ and Movies/; Android 10+ needs no permission for that. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Read aloud finds the device's text-to-speech engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".ResyncApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Resync"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Shows a crash's stack trace to copy or share; its own process, so the app's crash can't take it down. -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:process=":crash" />
        <receiver
            android:name=".watch.WatchWorker$StopWatchingReceiver"
            android:exported="false" />
        <receiver
            android:name=".notify.InboxWorker$InboxActionReceiver"
            android:exported="false" />
    </application>
</manifest>
